{
  "name": "@woohaa3/photocraft-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PhotoCraft 纯协议：编辑定义严格联合、引擎/能力/格式版本、资源上限、内容身份与命令解码。零宿主依赖。",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../../../client/web/scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@woohaa3/contracts": "link:../../../../client/web/contracts"
  }
}
